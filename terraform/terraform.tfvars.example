region = "KR"
site = "public"
name = "openclaw"
vpc_mode = "reuse"
subnet_mode = "reuse"
# vpc_no is optional for legacy reuse; explicit ID adds a membership check.
vpc_no = "REPLACE_WITH_VPC_ID"
subnet_no = "REPLACE_WITH_SUBNET_ID"
allocate_public_ip = true
login_key_name = "REPLACE_ME"
hypervisor = "KVM"
server_image_number = "REPLACE_WITH_LIVE_UBUNTU_X86_64_KVM_IMAGE_NUMBER"
server_spec_code = "REPLACE_WITH_COMPATIBLE_SPEC"
access_control_group_no_list = ["REPLACE_WITH_EXISTING_RESTRICTED_ACG"]
# XEN/RHV may instead use BOTH product-code fields; remove the two numbered fields.
